      "id": "5db37a34-8b57-4b44-8461-cb7e9a86b166",
      "name": "Descargar Archivo Binario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        160
