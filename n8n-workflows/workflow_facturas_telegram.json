        "url": "={{ $json.gemini_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "2251fcc0-6f9f-4bee-8b30-5b053ffce0dc",
      "name": "Gemini Vision OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst meta     = $('Normalizar Entrada').first().json;\n\nlet text = '';\ntry { text = response.candidates[0].content.parts[0].text; }\ncatch(e) { return [{ json: { parse_error: true, chat_id: meta.chat_id } }]; }\n\ntext = text.trim().replace(/^```json\\s*/i,'').replace(/```\\s*$/i,'');\n\nlet parsed;\ntry { parsed = JSON.parse(text); }\ncatch(e) { return [{ json: { parse_error: true, chat_id: meta.chat_id } }]; }\n\nreturn [{ json: {\n  ...parsed,\n  chat_id:          meta.chat_id,\n  usuario_telegram: meta.usuario_telegram,\n  extension:        meta.extension,\n  file_name_original: meta.file_name,\n  docs_base_path:   meta.docs_base_path,\n}}];",
        "mode": "runOnceForAllItems"
      },
